rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES AUXILIARES DE AUTENTICAÇÃO E RBAC
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'diiogo49@gmail.com';
    }

    function isAdmin() {
      return isMasterAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/players/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasSameEmailOwner() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        resource.data.email != null &&
        resource.data.email.lower() == request.auth.token.email.lower();
    }

    // ==========================================
    // COLEÇÃO: PLAYERS (ATLETAS E PERFIS)
    // ==========================================
    match /players/{playerId} {
      // Leitura permitida para atletas autenticados (escalação, ranking, lista de presença)
      allow read: if isAuthenticated();

      // Criação de perfil no onboarding (impede auto-promoção a admin, mensalista ou scout falso)
      allow create: if isAuthenticated() && (
        isOwner(playerId) || isAdmin()
      ) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'player' ||
        isMasterAdmin()
      ) && (
        isAdmin() || (
          (!('playerType' in request.resource.data) || request.resource.data.playerType == 'avulso') &&
          (!('goals' in request.resource.data) || request.resource.data.goals == 0) &&
          (!('assists' in request.resource.data) || request.resource.data.assists == 0) &&
          (!('concededGoals' in request.resource.data) || request.resource.data.concededGoals == 0) &&
          (!('hasNoShowFine' in request.resource.data) || request.resource.data.hasNoShowFine == false) &&
          (!('hasLateRemovalFine' in request.resource.data) || request.resource.data.hasLateRemovalFine == false) &&
          (!('fineAmount' in request.resource.data) || request.resource.data.fineAmount == 0)
        )
      );

      // Atualização de perfil
      allow update: if isAuthenticated() && (
        // Administrador pode atualizar qualquer campo
        isAdmin() ||
        // O próprio atleta atualizando seu perfil/presença/push
        ((isOwner(playerId) || hasSameEmailOwner()) && (
          // FE-02: Impede elevação de privilégios e alteração de categoria contratual
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'playerType'])) &&
          // FE-02: Protege estatísticas oficiais da temporada contra edição direta pelo atleta
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['goals', 'assists', 'concededGoals', 'totalGames', 'totalWins'])) &&
          // FE-02: Protege campos de multa contra redução/remoção arbitrária (permite apenas assinalar multa por retirada tardia)
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hasNoShowFine', 'hasLateRemovalFine', 'fineAmount', 'fineReason']) ||
           (request.resource.data.hasLateRemovalFine == true && request.resource.data.fineAmount >= 0))
        ))
      );

      // Exclusão permitida apenas para administradores
      allow delete: if isAdmin();
    }

    // ==========================================
    // COLEÇÃO: MATCHES (CONVOCAÇÕES E PARTIDAS)
    // ==========================================
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      // FE-01: Somente administradores podem criar, editar configurações ou excluir partidas
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // COLEÇÃO: SESSIONS (SORTEIO, TIMES E PLACAR)
    // ==========================================
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      // Gerenciamento dos times da pelada é restrito a administradores
      allow write: if isAdmin();
    }

    // ==========================================
    // COLEÇÃO: SETTINGS (CONFIGURAÇÕES GERAIS)
    // ==========================================
    match /settings/{settingId} {
      // CoverTeam e System podem ser lidos publicamente para preview social e manutenção
      allow read: if isAuthenticated() || settingId == 'coverTeam' || settingId == 'system';

      // FE-05: Apenas administradores alteram configurações financeiras, sistema ou time da capa
      // Exceção controlada: registro de disparo automático de lembrete de véspera apenas com campos permitidos
      allow write: if isAdmin() || (
        settingId == 'reminders' &&
        isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'lastAutoEveReminderKey',
          'lastAutoEveSentAt',
          'pendingCountAtSend',
          'lastManualReminderAt'
        ])
      );
    }

    // ==========================================
    // COLEÇÃO: COVERTEAMHISTORY (HISTÓRICO DA CAPA)
    // ==========================================
    match /coverTeamHistory/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // COLEÇÃO: RECEIPTS (COMPROVANTES PIX)
    // ==========================================
    match /receipts/{receiptId} {
      // O atleta só lê seus próprios comprovantes; Diretoria lê todos para conferência
      allow read: if isAdmin() || (isAuthenticated() && resource.data.playerId == request.auth.uid);

      // O atleta só pode registrar comprovante em seu próprio nome
      allow create: if isAuthenticated() && (
        request.resource.data.playerId == request.auth.uid || isAdmin()
      );

      // Alteração ou exclusão de comprovantes é restrita à Diretoria
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // COLEÇÃO: EXPENSES (DESPESAS E CAIXA)
    // ==========================================
    match /expenses/{expenseId} {
      // Acesso e gestão de despesas restrito à Diretoria
      allow read, write: if isAdmin();
    }

    // ==========================================
    // COLEÇÃO: NOTIFICATIONS (TRANSMISSÕES PUSH)
    // ==========================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      // FE-05: Exige que o remetente corresponda ao usuário autenticado (ou rotina de véspera)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.senderId == 'system_auto_eve'
      );
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // COLEÇÃO: LATEREMOVALS (AUDITORIA DE MULTAS)
    // ==========================================
    match /lateRemovals/{removalId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.playerId == request.auth.uid);
      // FE-05: Impede forjar registro de desistência tardia em nome de outro atleta
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.playerId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // BLOQUEIO PADRÃO: Menor privilégio
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
